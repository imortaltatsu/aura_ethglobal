# auraai - Environment Variables
# Copy this file to .env and fill in your API keys

# Local Whisper (STT)
WHISPER_MODEL=base

# XTTS TTS (Coqui, natural-sounding) - requires Docker server
# Run: docker run --gpus=all -e COQUI_TOS_AGREED=1 -p 8020:80 ghcr.io/coqui-ai/xtts-streaming-server:latest-cuda121
# List voices: curl http://localhost:8020/studio_speakers
XTTS_BASE_URL=http://127.0.0.1:8020
XTTS_VOICE_ID=Claribel Dervla
XTTS_LANGUAGE=EN

# Ollama (LLM) - e.g. OLLAMA_HOST=https://gpt.adityaberry.me ollama run gpt-oss:20b
OLLAMA_MODEL=gpt-oss:20b
OLLAMA_HOST=https://gpt.adityaberry.me

# Mem0 (in-process, Chroma)
MEM0_CHROMA_PATH=/workspace/proj/aura/data/mem0
MEM0_USER_ID=default_user

# Sui token context - comma-separated Llama token IDs
# Default: SUI, USDC, CETUS (Cetus), NAVX (Navi), SCA (Scallop)
# SUI_TOKEN_IDS=sui:0x2::sui::SUI,sui:0x...::usdc::USDC,sui:0x...::cetus::CETUS,...

# DipCoin / Sui - RPC and network
# DIPCOIN_TESTNET=true   # use Sui testnet (default)
# Optional: alt RPC for balance checks and dipcoin pool queries (and swap queries).
# Swap tx execution uses pysui config (GraphQL); point sui client testnet to same RPC/GraphQL if using alt.
# Official testnet GraphQL: https://graphql.testnet.sui.io/graphql
# Default JSON-RPC: fullnode.testnet.sui.io / fullnode.mainnet.sui.io
# NodeInfra (Mainnet & Testnet): https://docs.nodeinfra.com/
# DIPCOIN_SUI_RPC=https://sui-testnet.nodeinfra.com
# DIPCOIN_SUI_RPC=https://sui-mainnet.nodeinfra.com
# Server wallet - for on-chain swaps
# SERVER_WALLET_ADDRESS=0x...

# Local DB - SQLite (default) or DuckDB
# AURAAI_DB_PATH=./data/auraai.db
# AURAAI_DB_BACKEND=sqlite   # or duckdb

# Noisy environment: VAD and optional noise reduction
# Higher VAD confidence = less false triggers from background noise. VAD_STOP_SECS = silence before end-of-turn.
 VAD_CONFIDENCE=0.75
 VAD_STOP_SECS=0.4
 VAD_MIN_VOLUME=0.5
# Enable RNNoise input filter (install with: uv sync --extra noise-reduction):
# AURAAI_NOISE_REDUCTION=rnnoise

# WebRTC (SmallWebRTC) - ICE servers so client and server can connect across networks (e.g. SSH)
# Default: Google STUN. For TURN (relay) use e.g. turn:host:3478 (with credentials if required).
# WEBRTC_ICE_SERVERS=stun:stun.l.google.com:19302

# MCP (Model Context Protocol) - optional external tools
# Option 1: SSE server URL
# MCP_SERVER_URL=https://your.mcp.server/sse
# Option 2: Stdio (run local MCP server process)
# MCP_STDIO_COMMAND=npx
# MCP_STDIO_ARGS=["-y","@modelcontextprotocol/server-filesystem"]

