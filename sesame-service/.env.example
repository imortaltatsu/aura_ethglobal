# Sesame Service - Environment Variables
# Copy to .env and configure

# HuggingFace token (for gated models like sesame/csm-1b)
HF_TOKEN=

# Device map for multi-GPU: auto, balanced, sequential, or cuda:0
CSM_DEVICE_MAP=auto

# Set to 1 to disable torch.compile (faster startup, slower inference)
NO_TORCH_COMPILE=1

# Whisper model size for STT: tiny, base, small, medium, large-v3
WHISPER_MODEL=base
